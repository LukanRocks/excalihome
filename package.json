{
  "name": "excalihome",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "pnpm --parallel --filter excalihome-web --filter excalihome-backend dev",
    "build": "pnpm -C apps/backend build && pnpm -C apps/web build",
    "typecheck": "pnpm -C apps/backend typecheck && pnpm -C apps/web typecheck",
    "db:generate": "pnpm -C apps/backend db:generate",
    "prettier:format": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
